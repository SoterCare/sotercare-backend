# =============================================================================
# SoterCare backend — environment template
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
# Values marked (required) must be set or the service refuses to boot.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development            # 'production' disables TypeORM auto-synchronize
PORT=3000                       # api-gateway HTTP port
CORS_ORIGIN=                    # comma-separated allowlist; empty = allow all

# ---- Auth / JWT -------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string   # (required) signs & verifies JWTs
JWT_EXPIRES_IN=7d               # token lifetime (e.g. 12h, 7d)

# ---- PostgreSQL -------------------------------------------------------------
# Prefer a managed connection string (SSL auto-enabled). Falls back to DB_* below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=auth_db
DB_SSL=false

# ---- Redis ------------------------------------------------------------------
REDIS_URL=                      # rediss:// for managed Redis; else host/port below
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Inter-service gRPC URLs ------------------------------------------------
AUTH_GRPC_URL=0.0.0.0:50051
AUTH_SERVICE_URL=localhost:50051
EMAIL_GRPC_URL=0.0.0.0:50052
EMAIL_SERVICE_URL=localhost:50052
SUMMARY_GRPC_PORT=50053
SUMMARY_GRPC_URL=localhost:50053
HEALTH_GRPC_URL=0.0.0.0:50054
HEALTH_SERVICE_URL=localhost:50054

# ---- Device / ingest security ----------------------------------------------
# These now FAIL CLOSED: if unset, the corresponding endpoint is disabled.
RASPBERRY_API_KEY=              # gateway-level key for /logs/raspberry/sync
DEVICE_BOOTSTRAP_KEY=           # admin key for /devices/register
INTERNAL_SERVICE_TOKEN=         # token for /alerts/internal/alert-ready (AI -> gateway)
IOT_MAX_CLOCK_SKEW_MS=900000    # replay window (15 min)
IOT_ONLINE_TTL_SECONDS=300      # "online" window for device claim
IOT_CLAIM_REQUIRE_ONLINE=true

# ---- OTP throttling (auth) --------------------------------------------------
OTP_MAX_ATTEMPTS=5              # failed OTP verifications before lockout
OTP_LOCKOUT_SECONDS=900         # lockout duration after too many failures
AUTH_THROTTLE_TTL=60            # rate-limit window (seconds) for /auth/*
AUTH_THROTTLE_LIMIT=10          # max /auth/* requests per window per IP

# ---- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
EMAIL_SEND_TIMEOUT_MS=8000

# ---- AI summary service -----------------------------------------------------
GATEWAY_INTERNAL_URL=http://localhost:3000
SUMMARY_GRPC_MAX_MESSAGE_MB=20
POLL_INTERVAL_SECONDS=10
LOOKBACK_SECONDS=300
REPORT_INTERVAL_HOURS=6
MAX_LOGS_PER_REPORT=200
# Safety Guard thresholds
SPO2_LOW=92
HR_HIGH=120
HR_LOW=45
TEMP_FEVER=38.0
TEMP_LOW=35.5
MOISTURE_HIGH=80
MOISTURE_LOW=15
# Embeddings (pgvector)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIM=768

# ---- LLM providers (priority: Gemini -> Claude -> OpenAI -> Grok) -----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROK_API_KEY=
GROK_MODEL=grok-3-fast
